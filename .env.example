# 复制成 .env 后按需修改；部署到 Zeabur 时在服务的「环境变量」里逐条填

# 管理员令牌：用来创建命名空间、签发邀请码。请换成足够长的随机串
# 生成办法：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=please-change-me

# 数据目录。Zeabur 上必须挂持久卷到这个路径，否则重启数据全丢
DATA_DIR=./data

# 监听端口，本地默认 8080；Zeabur 会自动注入 PORT
PORT=8080

# 邀请码功能。你和朋友共用时打开它才能签发邀请码
ENABLE_INVITES=false

# 首次启动自动创建这个命名空间，并把令牌打印到日志里（只在创建时打印一次）
# Zeabur 上不方便开 shell，这是最省事的初始化方式
BOOTSTRAP_NAMESPACE=A

# 想指定固定令牌就填这里，留空则随机生成
BOOTSTRAP_TOKEN=
